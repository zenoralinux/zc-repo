#!/usr/bin/env bash
set -Eeuo pipefail

DATA_DIR="/usr/share/end4-dots"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
VENV_DIR="$XDG_STATE_HOME/quickshell/.venv"
BACKUP_ROOT="$HOME/ii-original-dots-backup/$(date -u +%Y%m%d-%H%M%S)"
BACKUP_CREATED=false
ASSUME_YES=false

log()  { printf '\033[1;36m[end4-install]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[end4-install] WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[end4-install] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: end4-install [--yes]

Install the end-4 Hyprland configuration and prepare the current Arch user.

Options:
  --yes   Skip the confirmation prompt. Existing files are still backed up.
  -h      Show this help.

Run this command as your normal desktop user, never with sudo.
EOF
}

while (($#)); do
    case "$1" in
        --yes|-y) ASSUME_YES=true ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unknown option: $1" ;;
    esac
    shift
done

[[ $EUID -ne 0 ]] || die "Do not run as root or with sudo. Run: end4-install"
[[ "$(uname -m)" == "x86_64" ]] || die "This package currently supports x86_64 only."
[[ -f /etc/arch-release ]] || die "An Arch Linux or Arch-based system is required."
[[ -d "$DATA_DIR/dots/.config" ]] || die "Installed dotfiles are missing: $DATA_DIR/dots/.config"

for cmd in sudo rsync uv; do
    command -v "$cmd" >/dev/null 2>&1 || die "Required command '$cmd' is missing. Install the end-4 dependency release first."
done

if ! command -v gsettings >/dev/null 2>&1; then
    warn "gsettings was not found; GNOME appearance settings will be skipped."
fi

if [[ "$ASSUME_YES" != true ]]; then
    cat <<EOF

This will install end-4's Hyprland configuration for:
  User: $USER
  Config: $XDG_CONFIG_HOME
  Data:   $XDG_DATA_HOME

Existing conflicting configuration directories/files will be backed up under:
  $BACKUP_ROOT

EOF
    read -r -p "Continue? [y/N] " answer
    [[ "$answer" =~ ^([yY]|[yY][eE][sS])$ ]] || { log "Cancelled."; exit 0; }
fi

sudo -v
mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

backup_target() {
    local target="$1"
    local relative="$2"
    [[ -e "$target" || -L "$target" ]] || return 0
    mkdir -p "$BACKUP_ROOT/$(dirname "$relative")"
    cp -a -- "$target" "$BACKUP_ROOT/$relative"
    BACKUP_CREATED=true
    log "Backed up: $target"
}

sync_dir() {
    local source="$1"
    local destination="$2"
    local label="$3"

    [[ -d "$source" ]] || die "Source directory does not exist: $source"
    backup_target "$destination" "$label"

    if [[ -L "$destination" || ( -e "$destination" && ! -d "$destination" ) ]]; then
        rm -f -- "$destination"
    fi
    mkdir -p "$destination"
    rsync -a --delete -- "$source/" "$destination/"
    log "Installed: $destination"
}

sync_dir_excluding_conf_d() {
    local source="$1"
    local destination="$2"
    local label="$3"

    [[ -d "$source" ]] || die "Source directory does not exist: $source"
    backup_target "$destination" "$label"

    if [[ -L "$destination" || ( -e "$destination" && ! -d "$destination" ) ]]; then
        rm -f -- "$destination"
    fi
    mkdir -p "$destination"
    rsync -a --delete --exclude='conf.d' -- "$source/" "$destination/"
    log "Installed: $destination (kept existing conf.d)"
}

copy_file() {
    local source="$1"
    local destination="$2"
    local label="$3"

    [[ -f "$source" ]] || die "Source file does not exist: $source"
    backup_target "$destination" "$label"

    if [[ -d "$destination" && ! -L "$destination" ]]; then
        die "Expected a file but found a directory: $destination"
    fi
    rm -f -- "$destination"
    install -Dm644 "$source" "$destination"
    log "Installed: $destination"
}

log "Installing general .config entries"
while IFS= read -r -d '' source; do
    name="$(basename "$source")"
    case "$name" in
        quickshell|fish|hypr|fontconfig) continue ;;
    esac

    destination="$XDG_CONFIG_HOME/$name"
    if [[ -d "$source" ]]; then
        sync_dir "$source" "$destination" "config/$name"
    elif [[ -f "$source" ]]; then
        copy_file "$source" "$destination" "config/$name"
    fi
done < <(find "$DATA_DIR/dots/.config" -mindepth 1 -maxdepth 1 -print0 | sort -z)

log "Installing Quickshell, Fish, Fontconfig and Konsole configuration"
[[ ! -d "$DATA_DIR/dots/.config/quickshell" ]] || \
    sync_dir "$DATA_DIR/dots/.config/quickshell" "$XDG_CONFIG_HOME/quickshell" "config/quickshell"
[[ ! -d "$DATA_DIR/dots/.config/fish" ]] || \
    sync_dir_excluding_conf_d "$DATA_DIR/dots/.config/fish" "$XDG_CONFIG_HOME/fish" "config/fish"
[[ ! -d "$DATA_DIR/dots/.config/fontconfig" ]] || \
    sync_dir "$DATA_DIR/dots/.config/fontconfig" "$XDG_CONFIG_HOME/fontconfig" "config/fontconfig"
[[ ! -d "$DATA_DIR/dots/.local/share/konsole" ]] || \
    sync_dir "$DATA_DIR/dots/.local/share/konsole" "$XDG_DATA_HOME/konsole" "local-share/konsole"

log "Installing Hyprland configuration"
HYPR_DIR="$XDG_CONFIG_HOME/hypr"
mkdir -p "$HYPR_DIR"

sync_dir "$DATA_DIR/dots/.config/hypr/hyprland" "$HYPR_DIR/hyprland" "config/hypr/hyprland"

if [[ -f "$HYPR_DIR/hyprland.conf" ]]; then
    backup_target "$HYPR_DIR/hyprland.conf" "config/hypr/hyprland.conf"
    backup_target "$HYPR_DIR/hyprland.conf.old" "config/hypr/hyprland.conf.old"
    mv -f -- "$HYPR_DIR/hyprland.conf" "$HYPR_DIR/hyprland.conf.old"
    log "Renamed old hyprland.conf to hyprland.conf.old (the new setup uses hyprland.lua)"
fi

copy_file "$DATA_DIR/dots/.config/hypr/hyprland.lua" "$HYPR_DIR/hyprland.lua" "config/hypr/hyprland.lua"
copy_file "$DATA_DIR/dots/.config/hypr/hyprlock.conf" "$HYPR_DIR/hyprlock.conf" "config/hypr/hyprlock.conf"
copy_file "$DATA_DIR/dots/.config/hypr/hypridle.conf" "$HYPR_DIR/hypridle.conf" "config/hypr/hypridle.conf"

# Preserve an existing custom directory so personal Hyprland overrides survive.
if [[ ! -e "$HYPR_DIR/custom" && ! -L "$HYPR_DIR/custom" ]]; then
    sync_dir "$DATA_DIR/dots/.config/hypr/custom" "$HYPR_DIR/custom" "config/hypr/custom"
else
    log "Preserving existing custom Hyprland overrides: $HYPR_DIR/custom"
fi

if [[ -f "$DATA_DIR/dots/.local/share/icons/illogical-impulse.svg" ]]; then
    install -d "$XDG_DATA_HOME/icons"
    copy_file "$DATA_DIR/dots/.local/share/icons/illogical-impulse.svg" \
        "$XDG_DATA_HOME/icons/illogical-impulse.svg" "local-share/icons/illogical-impulse.svg"
fi

log "Creating Quickshell Python virtual environment"
mkdir -p "$(dirname "$VENV_DIR")"
uv venv --prompt .venv --python 3.12 "$VENV_DIR"
uv pip install --python "$VENV_DIR/bin/python" -r "$DATA_DIR/requirements.txt"

log "Preparing user groups and kernel module configuration"
if ! getent group i2c >/dev/null 2>&1; then
    sudo groupadd i2c
fi

for group in video input i2c; do
    if getent group "$group" >/dev/null 2>&1; then
        if ! id -nG "$USER" | tr ' ' '\n' | grep -Fxq "$group"; then
            sudo usermod -aG "$group" "$USER"
            log "Added $USER to group $group"
        fi
    else
        warn "Group '$group' does not exist; skipping it."
    fi
done

printf 'i2c-dev\n' | sudo tee /etc/modules-load.d/i2c-dev.conf >/dev/null
sudo modprobe i2c-dev 2>/dev/null || warn "Could not load i2c-dev now; it will be loaded at boot if supported."

log "Preparing systemd services"
if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    if systemctl list-unit-files bluetooth.service --no-legend 2>/dev/null | grep -q 'bluetooth.service'; then
        sudo systemctl enable --now bluetooth.service
    else
        warn "bluetooth.service was not found; Bluetooth service setup was skipped."
    fi

    if [[ -n "${XDG_RUNTIME_DIR:-}" && -S "${XDG_RUNTIME_DIR}/bus" ]] && \
       systemctl --user cat ydotool.service >/dev/null 2>&1; then
        systemctl --user enable --now ydotool.service || warn "Could not enable the ydotool user service."
    else
        warn "ydotool user service or user D-Bus session is unavailable; enable it after logging in if needed."
    fi
else
    warn "systemd was not detected. The automatic service setup in this installer targets systemd-based Arch systems."
fi

log "Applying optional desktop appearance settings"
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface font-name 'Google Sans Flex Medium 11 @opsz=11,wght=500' || \
        warn "Could not set the GNOME interface font."
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || \
        warn "Could not set the GNOME color scheme."
fi
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Darkly || \
        warn "Could not set the KDE widget style."
fi
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f >/dev/null 2>&1 || warn "Font cache refresh failed."
fi

mkdir -p "$XDG_CONFIG_HOME/illogical-impulse"
touch "$XDG_CONFIG_HOME/illogical-impulse/installed_true"

if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl reload || warn "Hyprland reload failed; log out and back in to apply the new configuration."
fi

printf '\n'
log "Installation completed."
if [[ "$BACKUP_CREATED" == true ]]; then
    log "Your previous settings were backed up to: $BACKUP_ROOT"
else
    log "No conflicting configuration files needed backup."
fi
warn "Log out and back in before using the new Hyprland configuration."
warn "Group membership changes also require a new login session."
log "This installer manages the end-4 dotfiles; it does not install GPU drivers or configure the boot/display manager."
